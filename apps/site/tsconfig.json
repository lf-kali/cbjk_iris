{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2017",
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    // aliases que o core usa para ler o projeto; os mesmos do withIris (SPEC §5.1.3)
    "paths": {
      "@cbjk_iris/site-config": ["./site.config.ts"],
      "@cbjk_iris/site-registry": ["./app/iris.registry.generated.tsx"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
