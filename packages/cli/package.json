{
  "name": "@cbjk_iris/cli",
  "version": "0.0.0",
  "description": "CLI \"iris\" do Iris. Implementação: frente iris-cli.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@cbjk_iris/engine": "0.0.0",
    "@cbjk_iris/schema": "0.0.0"
  }
}
