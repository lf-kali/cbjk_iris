{
  "name": "@cbjk_iris/engine",
  "version": "0.0.0",
  "description": "Lógica de Node do Iris: tema, fontes, codegen, módulos, conteúdo e withIris.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lf-kali/cbjk_iris.git",
    "directory": "packages/engine"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.18"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "themes"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./next": {
      "types": "./dist/next.d.mts",
      "default": "./dist/next.mjs"
    },
    "./theme": {
      "types": "./dist/theme.d.mts",
      "default": "./dist/theme.mjs"
    },
    "./codegen": {
      "types": "./dist/codegen.d.mts",
      "default": "./dist/codegen.mjs"
    },
    "./content": {
      "types": "./dist/content.d.mts",
      "default": "./dist/content.mjs"
    },
    "./themes/*": "./themes/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@cbjk_iris/schema": "0.0.0",
    "culori": "^4.0.2"
  },
  "peerDependencies": {
    "next": "^16"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/culori": "^4.0.1"
  }
}
