{
  "name": "@cbjk_iris/schema",
  "version": "0.0.0",
  "description": "Contratos do Iris: tipos, schemas e constantes do config e do conteúdo.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.18"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./defaults": {
      "types": "./dist/defaults.d.mts",
      "default": "./dist/defaults.mjs"
    },
    "./json/*": "./json/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown && node scripts/write-json.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
