{
  "$comment": "Módulos opcionais do template. Um módulo está ativo quando o primeiro de seus 'paths' (a rota principal) existe. Para desligar: apague os paths, tire os itens de 'menu' e as seções de 'sections' do site.config.ts (home e páginas), desinstale as 'dependencies' e rode npm run modules:sync. npm run modules:check testa a remoção de cada módulo.",
  "coreSections": {
    "hero": {
      "from": "@/components/sections/HeroSection",
      "export": "HeroSection"
    },
    "benefits": {
      "from": "@/components/sections/BenefitsSection",
      "export": "BenefitsSection"
    },
    "text-image": {
      "from": "@/components/sections/TextImageSection",
      "export": "TextImageSection"
    },
    "cta-banner": {
      "from": "@/components/sections/CtaBannerSection",
      "export": "CtaBannerSection"
    },
    "testimonials": {
      "from": "@/components/sections/TestimonialsSection",
      "export": "TestimonialsSection"
    },
    "stats": {
      "from": "@/components/sections/StatsSection",
      "export": "StatsSection"
    },
    "faq": {
      "from": "@/components/sections/FaqSection",
      "export": "FaqSection"
    },
    "contact": {
      "from": "@/components/sections/ContactSection",
      "export": "ContactSection"
    },
    "lead-form": {
      "from": "@/components/sections/LeadFormSection",
      "export": "LeadFormSection"
    },
    "widget": {
      "from": "@/components/sections/WidgetSection",
      "export": "WidgetSection"
    }
  },
  "modules": [
    {
      "id": "products",
      "name": "Produtos",
      "paths": [
        "app/produtos",
        "app/produto",
        "components/products",
        "lib/catalog/products.ts",
        "data/products.ts",
        "public/products"
      ],
      "menu": [
        "/produtos"
      ],
      "dependencies": [],
      "sections": {
        "products": {
          "from": "@/components/products/ProductsSection",
          "export": "ProductsSection"
        }
      }
    },
    {
      "id": "services",
      "name": "Serviços",
      "paths": [
        "app/servicos",
        "app/servico",
        "components/services",
        "lib/catalog/services.ts",
        "data/services.ts",
        "public/services"
      ],
      "menu": [
        "/servicos"
      ],
      "dependencies": [],
      "sections": {
        "services": {
          "from": "@/components/services/ServicesSection",
          "export": "ServicesSection"
        }
      }
    },
    {
      "id": "gallery",
      "name": "Últimos projetos",
      "paths": [
        "app/ultimos-projetos",
        "components/gallery",
        "lib/gallery.ts",
        "public/ultimos_projetos"
      ],
      "menu": [
        "/ultimos-projetos"
      ],
      "dependencies": [
        "image-size",
        "react-photo-album"
      ],
      "sections": {
        "gallery": {
          "from": "@/components/gallery/GallerySection",
          "export": "GallerySection"
        }
      }
    }
  ]
}
